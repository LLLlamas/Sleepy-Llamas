# Email-first is safe to publish while the online backend is deferred.
PUBLIC_INQUIRY_MODE=email

# Set mode to online only after completing PUBLISHING.md activation checks.
# Supabase — public values (safe to embed in client bundle)
# Get these from: Supabase Dashboard → Settings → API
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key-here
