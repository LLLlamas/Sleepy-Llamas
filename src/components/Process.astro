---
const steps = [
  {
    n: '1',
    title: 'Tell me what feels hard',
    body: 'A new baby, a toddler transition, or getting everyone on the same page. Share what you need and whether you prefer a call or support at home.',
    linkText: 'Start a conversation',
    linkHref: '#contact',
  },
  {
    n: '2',
    title: 'Choose your support',
    body: 'We agree on the right session, a time, and the price before booking. If you are unsure, a complimentary 15-minute fit call can help you decide.',
  },
  {
    n: '3',
    title: 'Work through it together',
    body: 'Bring your questions, your co-parent, or your caregiver. We focus on your priorities and build practical steps that fit your family and your care team&rsquo;s instructions.',
  },
  {
    n: '4',
    title: 'Leave with a clear plan',
    body: 'You receive a written plan or family care guide, plus the follow-up included in your service. If you need more time, we can arrange another session.',
    linkText: 'Compare support options',
    linkHref: '#services',
  },
];
---

<section class="section process" id="process">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">How it works</span>
      <h2>A clear next step, together.</h2>
      <p class="lead">Practical support, personal attention, and room for your questions.</p>
    </div>

    <ol class="timeline" role="list">
      {steps.map((step, i) => (
        <li class:list={["timeline-step", "reveal", `reveal-delay-${i + 1}`]}>
          <div class="step-top">
            <div class="step-number">{step.n}</div>
            {i < steps.length - 1 && (
              <div class="step-connector" aria-hidden="true">
                <span class="dash"></span>
                <span class="dash"></span>
                <span class="dash"></span>
                <span class="dash"></span>
                <span class="dash"></span>
              </div>
            )}
          </div>
          <div class="step-body">
            <h3>{step.title}</h3>
            <p set:html={step.body}></p>
            {step.linkText && (
              <a href={step.linkHref} class="step-link">{step.linkText} &rarr;</a>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process {
    background: var(--color-blush-100);
  }

  .section-head {
    max-width: 680px;
    margin: 0 auto 3rem;
    text-align: center;
  }
  .section-head .lead { margin-inline: auto; }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 3vw, 2rem);
    counter-reset: step;
  }

  .timeline-step {
    position: relative;
    padding-top: 0.5rem;
  }

  .step-top {
    display: flex;
    align-items: center;
    margin-bottom: 1rem;
    position: relative;
  }

  .step-number {
    display: inline-grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-cream);
    border: 2px solid var(--color-maroon-700);
    color: var(--color-maroon-700);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    box-shadow: var(--shadow-soft);
    position: relative;
    z-index: 2;
    flex-shrink: 0;
    transition: background 0.3s var(--ease-out), border-color 0.3s var(--ease-out);
  }
  .step-number:hover {
    background: var(--color-blush-100);
    border-color: var(--color-maroon-500);
  }

  /* Connector: individual dash elements */
  .step-connector {
    display: flex;
    align-items: center;
    gap: 5px;
    flex: 1;
    padding: 0 4px;
    z-index: 1;
  }

  .dash {
    display: block;
    flex: 1;
    height: 2px;
    background: var(--color-maroon-300);
    border-radius: 1px;
  }

  .step-body h3 {
    font-size: 1.2rem;
    margin-bottom: 0.4em;
  }
  .step-body p {
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .step-link {
    display: inline-block;
    margin-top: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-maroon-700);
    border-bottom: 1.5px solid transparent;
    transition: border-color 0.2s var(--ease-out);
  }
  .step-link:hover {
    border-bottom-color: var(--color-maroon-500);
  }

  @media (max-width: 900px) {
    .timeline {
      grid-template-columns: 1fr;
      max-width: 480px;
      margin-inline: auto;
      gap: 2rem;
    }
    .timeline-step {
      display: grid;
      grid-template-columns: auto 1fr;
      grid-template-rows: auto;
      gap: 0 1.25rem;
      align-items: start;
    }
    .step-top {
      flex-direction: column;
      margin-bottom: 0;
      grid-row: 1 / 3;
    }
    .step-connector {
      flex-direction: column;
      padding: 4px 0;
      gap: 4px;
      align-items: center;
      flex: none;
      height: auto;
      margin-top: 4px;
    }
    .dash {
      width: 2px;
      height: 8px;
      flex: none;
    }
  }
</style>
