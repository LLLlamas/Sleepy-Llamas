---
import { fitCall } from '../config/services';
const careNotes = [
  { number: '01', title: 'First, I listen.', body: 'Tell me what a day looks like, what feels hard, and what matters to you. Your family’s culture, preferences, and existing routines belong in the plan.' },
  { number: '02', title: 'We make it practical.', body: 'We can talk through a difficult transition, practice a care routine, or help a new nanny understand your home. I explain the steps and leave room for questions.' },
  { number: '03', title: 'Everyone knows the next step.', body: 'A useful handoff makes room for what happened, what helped, and anything that needs a parent’s attention. We agree on follow-up so you know what support comes next.' },
];
---

<section class="section care-style" aria-labelledby="care-style-title">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">How I work</span>
      <h2 id="care-style-title">Thoughtful care.<br />Something you can use tomorrow.</h2>
      <p class="lead">My approach to working with your family, in my own words.</p>
    </div>
    <div class="care-grid">
      {careNotes.map((note, i) => (
        <article class:list={['care-note', 'reveal', `reveal-delay-${i + 1}`]}>
          <span class="care-number" aria-hidden="true">{note.number}</span>
          <h3>{note.title}</h3><p>{note.body}</p>
        </article>
      ))}
    </div>
    <div class="care-invitation reveal">
      <p>You can bring one question.<br /><span>We&rsquo;ll work out where to begin.</span></p>
      <a href="#contact" class="btn btn-secondary" data-consult-service={fitCall.id}>Ask for a free 15-minute fit call</a>
    </div>
  </div>
</section>

<style>
  .care-style { background: var(--color-blush-200); }
  .section-head { max-width: 640px; margin-bottom: 2.25rem; }
  .section-head h2 { font-size: clamp(2rem, 3.5vw, 2.65rem); }
  .section-head .lead { font-size: 0.96rem; }
  .care-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.25rem, 3vw, 2.5rem); }
  .care-note { border-top: 1px solid rgba(107, 26, 40, 0.22); padding-top: 1.25rem; }
  .care-number { color: var(--color-maroon-500); font-size: 0.75rem; letter-spacing: 0.08em; }
  .care-note h3 { margin: 1rem 0 0.7rem; font-size: 1.4rem; line-height: 1.25; }
  .care-note p { font-size: 0.92rem; color: var(--color-muted); line-height: 1.8; margin: 0; }
  .care-invitation { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.25rem; margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--color-border); }
  .care-invitation p { font-family: var(--font-display); font-size: 1.45rem; color: var(--color-maroon-900); line-height: 1.35; margin: 0; }
  .care-invitation p span { color: var(--color-muted); }
  .care-invitation .btn { font-size: 0.9rem; }
  @media (max-width: 800px) { .care-grid { grid-template-columns: 1fr; gap: 1.75rem; } .care-note { max-width: 600px; } }
</style>
