---
const careNotes = [
  {
    title: 'Care that notices the details',
    body:
      'Overnight support is more than staying awake. I track feeding rhythms, soothing patterns, sleep windows, and the small changes parents are too tired to hold alone.',
    meta: 'Best for newborn nights and sleep transitions',
  },
  {
    title: 'A steady hand with specialized routines',
    body:
      'My resume includes G-tube support, hearing-aid assistance, cleft palate care plans, autism support, and therapy routines followed under specialist guidance.',
    meta: 'Best for families with extra care instructions',
  },
  {
    title: 'Practical help that protects recovery',
    body:
      'I have supported postpartum recovery after C-section delivery, newborn twins, feeding transitions, and the household tasks that make rest easier to access.',
    meta: 'Best for postpartum recovery and twin care',
  },
];
---

<section class="section testimonials">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Care style</span>
      <h2>The kind of support families feel right away.</h2>
    </div>

    <div class="testimonials-grid">
      {careNotes.map((t, i) => (
        <figure class:list={["testimonial", "reveal", `reveal-delay-${i + 1}`]}>
          <svg class="quote-mark" viewBox="0 0 32 32" aria-hidden="true">
            <path d="M16 3l10 5v7c0 6.8-4.4 11.5-10 14-5.6-2.5-10-7.2-10-14V8l10-5Z" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M11 16l3 3 7-8" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <blockquote>
            <strong>{t.title}</strong>
            <span>{t.body}</span>
          </blockquote>
          <figcaption>
            <span class="role">{t.meta}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <!-- Referral CTA -->
    <div class="referral reveal reveal-delay-4">
      <p class="referral-text">Know a family that could use a good night&rsquo;s sleep?</p>
      <a
        class="btn btn-secondary referral-btn"
        href={`mailto:?subject=Check out Sleepy Llamas overnight doula %26 sleep training&body=I wanted to share Sleepy Llamas with you. Catalina offers certified overnight doula care and gentle sleep support in the New York area.%0A%0Ahttps://sleepyllamasdoula.com`}
      >
        Share with a friend &hearts;
      </a>
    </div>
  </div>
</section>

<style>
  .testimonials {
    background: var(--color-blush-200);
  }

  .section-head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 3rem;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .testimonial {
    position: relative;
    background: var(--color-cream);
    border-radius: var(--radius-lg);
    padding: 2.25rem 1.75rem 1.75rem;
    box-shadow: var(--shadow-soft);
    border: 1px solid var(--color-border);
    margin: 0;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s var(--ease-out);
  }
  .testimonial:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-medium);
  }

  .quote-mark {
    width: 40px;
    height: 40px;
    color: var(--color-maroon-500);
    margin-bottom: 0.5rem;
  }

  blockquote {
    font-size: 0.98rem;
    line-height: 1.55;
    margin: 0 0 1.5rem;
  }
  blockquote strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.18rem;
    font-weight: 500;
    color: var(--color-maroon-900);
    margin-bottom: 0.55rem;
  }
  blockquote span {
    color: var(--color-muted);
  }

  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }
  .role {
    font-size: 0.85rem;
    color: var(--color-maroon-700);
    font-weight: 600;
  }

  .referral {
    text-align: center;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid var(--color-border);
  }
  .referral-text {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--color-maroon-900);
    margin-bottom: 1rem;
  }
  .referral-btn {
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
      max-width: 540px;
      margin-inline: auto;
    }
  }
</style>
