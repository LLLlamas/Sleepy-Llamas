---
import { site } from '../config/site';
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const resumeHref = `${base}resume/`;
---

<section class="hero" id="top">
  <div class="container hero-inner">
    <div class="hero-copy">
      <span class="eyebrow hero-anim hero-anim-1">Certified Doula &middot; Overnight Sleep Specialist</span>
      <h1 class="hero-anim hero-anim-2">
        Restful nights,<br />
        gentle beginnings.
      </h1>
      <p class="lead hero-anim hero-anim-3">
        I offer certified overnight doula care and gentle sleep support for New
        York families. Rest is not a luxury &mdash; it&rsquo;s the foundation of
        bonding, healing, and feeling like yourself again.
      </p>
      <div class="hero-actions hero-anim hero-anim-3">
        <a href="#contact" class="btn btn-primary">Reach out for a consultation</a>
        <a href="#services" class="hero-link">Explore services &rarr;</a>
      </div>
      <div class="hero-trust hero-anim hero-anim-3" aria-label="Catalina's experience highlights">
        <span>8 years caring for infants and twins</span>
        <span>Certified lactation support</span>
        <a href={resumeHref}>View my resume</a>
      </div>
      <p class="hero-meta hero-anim hero-anim-3">
        Serving {site.serviceArea} &middot; Response {site.responseTime}
      </p>
    </div>

    <div class="hero-art" aria-hidden="true">
      <svg viewBox="0 0 400 400" class="hero-illustration">
        <defs>
          <radialGradient id="moon-grad" cx="50%" cy="45%" r="55%">
            <stop offset="0%" stop-color="#fffaf5" />
            <stop offset="60%" stop-color="#f7e6e2" />
            <stop offset="100%" stop-color="#f0d2cb" />
          </radialGradient>
          <linearGradient id="accent-grad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#a83246" />
            <stop offset="100%" stop-color="#6b1a28" />
          </linearGradient>
        </defs>

        <!-- Soft moon -->
        <circle cx="200" cy="180" r="140" fill="url(#moon-grad)" />

        <!-- Subtle stars -->
        <circle cx="90" cy="80" r="2.5" fill="#c89b6a" opacity="0.7" />
        <circle cx="320" cy="110" r="2" fill="#c89b6a" opacity="0.6" />
        <circle cx="340" cy="260" r="2.5" fill="#c89b6a" opacity="0.7" />
        <circle cx="70" cy="280" r="2" fill="#c89b6a" opacity="0.6" />

        <!-- Crescent accent -->
        <path
          d="M230 110c-30 10-52 38-52 70 0 32 22 60 52 70-45 4-84-30-84-70s39-74 84-70Z"
          fill="url(#accent-grad)"
          opacity="0.92"
        />

        <!-- Cloud base -->
        <path
          d="M80 340c0-18 15-30 34-28 6-16 22-26 40-22 10-14 28-20 46-14 14-10 34-8 46 6 16-2 30 10 30 26 0 18-14 32-32 32H112c-18 0-32-12-32-0Z"
          fill="#fffaf5"
          opacity="0.85"
        />
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(4rem, 10vw, 8rem);
    background:
      linear-gradient(180deg, var(--color-blush-100) 0%, var(--color-blush-200) 100%),
      repeating-linear-gradient(90deg, rgba(107, 26, 40, 0.04) 0 1px, transparent 1px 96px);
  }

  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero-copy h1 {
    margin-top: 0.35em;
    margin-bottom: 0.5em;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: center;
    margin-top: 1.75rem;
  }

  .hero-link {
    font-weight: 500;
    color: var(--color-maroon-700);
    position: relative;
  }
  .hero-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 1.5px;
    background: var(--color-maroon-500);
    transform: scaleX(0.6);
    transform-origin: left;
    transition: transform 0.3s var(--ease-out);
  }
  .hero-link:hover::after { transform: scaleX(1); }

  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.5rem;
  }
  .hero-trust span,
  .hero-trust a {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 250, 245, 0.75);
    border: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 600;
  }
  .hero-trust a {
    color: var(--color-maroon-700);
  }
  .hero-trust a:hover {
    border-color: var(--color-maroon-300);
  }

  .hero-meta {
    margin-top: 2rem;
    font-size: 0.875rem;
    color: var(--color-muted);
    letter-spacing: 0.02em;
  }

  .hero-art {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .hero-illustration {
    width: 100%;
    max-width: 460px;
    height: auto;
    filter: drop-shadow(0 20px 40px rgba(61, 15, 23, 0.15));
  }

  @media (max-width: 880px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: left;
    }
    .hero-art {
      order: -1;
      max-width: 320px;
      margin: 0 auto 1rem;
    }
  }
</style>
