---
import { site } from '../config/site';
import { fitCall } from '../config/services';
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const resumeHref = `${base}resume/`;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero-inner">
    <div class="hero-copy">
      <span class="eyebrow hero-anim hero-anim-1">Family consulting &amp; postpartum care · New York</span>
      <h1 id="hero-title" class="hero-anim hero-anim-2">A little steadiness<br />for your <em>whole family.</em></h1>
      <p class="lead hero-anim hero-anim-3">
        I&rsquo;m Catalina. I help parents and caregivers work through the everyday
        questions, new-baby days, and changing routines that come with raising children.
        We can talk it through, make a practical plan, or work on it together at home.
      </p>
      <div class="hero-actions hero-anim hero-anim-3">
        <a href="#services" class="btn btn-primary">Find your kind of support</a>
        <a href="#contact" class="hero-link" data-consult-service={fitCall.id}>Start with a free 15-minute fit call &rarr;</a>
      </div>
      <p class="hero-fit hero-anim hero-anim-3">A short introduction to understand what you need. Personalized guidance is booked separately.</p>
      <div class="hero-trust hero-anim hero-anim-3" aria-label="Catalina's experience highlights">
        <span>8 years of hands-on family care</span><span>Spanish &amp; English</span>
        <a href={resumeHref}>Meet my experience &rarr;</a>
      </div>
      <p class="hero-meta hero-anim hero-anim-3">In-person support in {site.serviceArea} &middot; Phone &amp; video consultations</p>
    </div>
    <aside class="care-letter hero-anim hero-anim-3" aria-label="A note from Catalina">
      <span class="letter-kicker">A note from Catalina</span>
      <span class="letter-rule" aria-hidden="true"></span>
      <p class="letter-heading">You can start with<br />what&rsquo;s happening today.</p>
      <p>Maybe you&rsquo;re bringing your first baby home. Maybe your third has just arrived, and the older children still need you. Or your nanny is starting, and you want everyone working together.</p>
      <p>You don&rsquo;t need to have the right words or a perfectly organized list. Tell me about your family. That&rsquo;s where we begin.</p>
      <p class="letter-signature">Catalina Llamas</p>
      <p class="letter-footer">Founder, Sleepy Llamas<br />Nanny · Postpartum Doula · House Manager</p>
    </aside>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; padding-block: clamp(3.25rem, 7vw, 6rem) clamp(3.5rem, 7vw, 6rem); background: radial-gradient(ellipse at 95% 90%, var(--color-blush-300), transparent 55%), var(--color-blush-100); }
  .hero-inner { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, .9fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .hero-copy h1 { font-size: clamp(2.65rem, 4.8vw, 4.2rem); line-height: 1.04; letter-spacing: -.035em; margin: .22em 0 .42em; }
  .hero-copy h1 em { font-weight: inherit; color: var(--color-maroon-500); }
  .hero-copy .lead { max-width: 50ch; font-size: 1.08rem; line-height: 1.72; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; align-items: center; margin-top: 1.75rem; }
  .hero-link { font-size: 0.92rem; font-weight: 600; text-decoration: underline; text-underline-offset: 5px; }
  .hero-fit { font-size: 0.8rem; color: var(--color-muted); max-width: 52ch; margin-top: 1rem; }
  .hero-trust { display: flex; flex-wrap: wrap; gap: 0.5rem 1.1rem; border-top: 1px solid var(--color-border); margin-top: 1.65rem; padding-top: 1rem; font-size: 0.8rem; color: var(--color-muted); }
  .hero-trust a { font-weight: 600; }
  .hero-meta { margin: 1rem 0 0; font-size: 0.8rem; color: var(--color-muted); }
  .care-letter { position: relative; background: var(--color-cream); border: 1px solid var(--color-border); border-radius: 3px 3px 48px 3px; padding: clamp(1.5rem, 3vw, 2.25rem); box-shadow: 10px 15px 0 rgba(107, 26, 40, 0.045), var(--shadow-soft); }
  .letter-kicker { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.13em; text-transform: uppercase; color: var(--color-maroon-500); }
  .letter-rule { display: flex; align-items: center; gap: .45rem; margin: 1.1rem 0 1.4rem; color: var(--color-gold); }
  .letter-rule::before { content: ''; width: 2.4rem; border-top: 1px solid currentColor; }
  .letter-rule::after { content: ''; width: .32rem; height: .32rem; background: currentColor; transform: rotate(45deg); }
  .care-letter::before { content: ''; position: absolute; inset: .45rem; border: 1px solid var(--color-border); border-radius: 1px 1px 42px 1px; pointer-events: none; }
  .letter-heading { font-family: var(--font-display); font-size: clamp(1.6rem, 2.4vw, 2rem); line-height: 1.25; color: var(--color-maroon-900); }
  .care-letter > p:not(.letter-heading):not(.letter-signature):not(.letter-footer) { font-size: 0.92rem; line-height: 1.8; color: var(--color-muted); }
  .letter-signature { font-family: var(--font-display); font-style: italic; font-size: 1.55rem; color: var(--color-maroon-700); margin: 1.8rem 0 0.3rem; }
  .letter-footer { font-size: 0.7rem; line-height: 1.6; color: var(--color-muted); margin-bottom: 0; }
  @media (max-width: 880px) { .hero-inner { grid-template-columns: minmax(0, 40rem); justify-content: center; } .care-letter { width: 100%; } }
  @media (max-width: 480px) { .hero-actions { display: grid; justify-items: center; gap: .6rem; } .hero-fit { text-align: center; } .hero-actions .btn { width: 100%; } .hero-link { padding-block: 0.5rem; } .hero-trust { gap: .45rem 1rem; } }
</style>
