---
import { consultingServices, fitCall, consultationAddOns, overnightServices, overnightPackages } from '../config/services';
import { servicePagePath, withBase } from '../config/serviceRoutes';
const categoryLabels = {
  family: 'Everyday family life',
  newborn: 'Newborn & postpartum',
  home: 'Hands-on support',
  training: 'Your care team',
};
---

<section class="section services" id="services" aria-labelledby="services-heading">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Support that meets you where you are</span>
      <h2 id="services-heading">A conversation. A plan.<br />A little more confidence.</h2>
      <p class="lead">
        A first baby, another baby, a new nanny, or a routine that needs a rethink.
        Choose the kind of support you need, and we&rsquo;ll make the next step feel manageable.
      </p>
    </div>

    <div class="services-grid">
      {consultingServices.map((service, i) => (
        <article class:list={['service-card', 'card', 'reveal', `reveal-delay-${Math.min(i + 1, 4)}`, i < 2 && 'call-card', service.featured && 'featured']}>
          <span class="service-category">{categoryLabels[service.category]}</span>
          <h3>{service.title}</h3>
          <p class="service-description">{service.description}</p>
          <div class="service-rate">
            <p class="service-price"><span>From</span> ${service.price.toLocaleString()}</p>
            <p class="service-duration">{service.duration}<span>{service.format}</span></p>
          </div>
          <ul class="service-bullets" role="list">
            {service.bullets.map((bullet) => <li>{bullet}</li>)}
          </ul>
          <div class="service-actions">
          {servicePagePath(service.id) && <a class="service-detail-link" href={withBase(servicePagePath(service.id)!)}>What we&rsquo;ll work on together &rarr;</a>}
          <a href="#contact" class="service-link" data-consult-service={service.id}>
            {service.linkText} <span aria-hidden="true">&rarr;</span>
          </a>
          </div>
        </article>
      ))}
    </div>

    <p class="rates-note reveal">
      Starting rates shown. I&rsquo;ll confirm your session, scope, and final price with you before booking.
      Home visits depend on location and availability; any travel fee is agreed in advance.
    </p>

    <div class="fit-call reveal">
      <div>
        <span class="eyebrow">A friendly place to start</span>
        <h3>{fitCall.title}</h3>
        <p>{fitCall.description}</p>
      </div>
      <div class="fit-action">
        <span>Complimentary &middot; {fitCall.duration}</span>
        <a href="#contact" class="btn btn-secondary" data-consult-service={fitCall.id}>Ask for a fit call <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>

    <div class="followup-section reveal">
      <div class="followup-heading">
        <span class="eyebrow">When you need a little more time</span>
        <h3>Keep the support going.</h3>
        <p>For existing clients, with a clear amount of time and a shared plan. Additional sessions are subject to availability.</p>
      </div>
      <dl class="followup-list">
        {consultationAddOns.map((addon) => (
          <div class="followup-row">
            <dt>{addon.title}<span>{addon.description}</span></dt>
            <dd>${addon.price} <span>/ {addon.duration}</span></dd>
          </div>
        ))}
      </dl>
    </div>

    <p class="scope-note reveal">
      My support is practical and non-medical. We follow your care team&rsquo;s instructions and make room for referrals when needed.
      Caregiver coaching is tailored to your household and does not award professional or CPR certification.
    </p>

    <div class="overnight-section reveal" id="overnight-care">
      <div class="overnight-heading">
        <div>
          <span class="eyebrow">And when you need rest</span>
          <h3>Overnight care is here, too.</h3>
        </div>
        <a href="#availability" class="service-link">Explore overnight availability <span aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="overnight-options">
        {overnightServices.map((service) => (
          <div>
            <h4>{service.title}</h4>
            <p>{service.description}</p>
          </div>
        ))}
      </div>
      <details class="overnight-details">
        <summary>View overnight packages <span aria-hidden="true">+</span></summary>
        <div class="packages-grid">
          {overnightPackages.map((pkg) => (
            <article class="pkg-card">
              <h4 class="pkg-name">{pkg.name}</h4>
              <p class="pkg-nights">{pkg.nights} <span>nights</span></p>
              <p class="pkg-timeframe">{pkg.timeframe}</p>
              <p class="pkg-price">${pkg.price.toLocaleString()}</p>
              <p class="pkg-special">Additional care: ${pkg.specialPrice.toLocaleString()}</p>
              <a href="#availability" class="pkg-cta" data-package={pkg.key}>Ask about {pkg.nights} nights <span aria-hidden="true">&rarr;</span></a>
            </article>
          ))}
        </div>
        <p class="packages-note">
          Additional-care rates are a starting point for families who need more support, including twins.
          We&rsquo;ll discuss your instructions, the right fit, and final pricing together.
        </p>
      </details>
    </div>
  </div>
</section>

<style>
  .service-detail-link { font-size: .88rem; text-decoration: underline; text-underline-offset: .2em; margin: 0; }
  .services { background: var(--color-blush-200); }
  .section-head { max-width: 720px; margin: 0 auto 2.5rem; text-align: center; }
  .section-head .lead { margin-inline: auto; }
  .services-grid { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 1.25rem; }
  .service-card { grid-column: span 2; display: flex; flex-direction: column; min-width: 0; }
  .service-actions { display: grid; align-content: end; justify-items: start; gap: .35rem; margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--color-border); }
  .service-actions .service-link { margin: 0; }
  @media (min-width: 701px) {
    .service-card { display: grid; grid-row: span 6; grid-template-rows: subgrid; row-gap: 0; }
    .service-card > * { min-width: 0; }
    .service-card .service-rate { align-self: stretch; }
  }
  .service-card.call-card { grid-column: span 3; }
  .service-card.featured { background: linear-gradient(160deg, var(--color-cream), var(--color-blush-100)); border-color: var(--color-maroon-500); }
  .service-category { color: var(--color-maroon-700); font-size: 0.7rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.85rem; }
  .service-card h3 { font-size: clamp(1.4rem, 2.2vw, 1.8rem); margin-bottom: 0.65rem; }
  .service-description { color: var(--color-muted); font-size: 0.94rem; line-height: 1.65; }
  .service-rate { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1rem; margin: 1.35rem 0 0; padding: 1rem 0; border-block: 1px solid var(--color-border); }
  .service-price { color: var(--color-maroon-700); font-family: var(--font-display); font-size: 2rem; line-height: 1.2; margin: 0; white-space: nowrap; }
  .service-price > span { font-family: var(--font-body); font-size: 0.75rem; color: var(--color-muted); }
  .service-duration { margin: 0; color: var(--color-maroon-900); font-size: 0.83rem; font-weight: 600; }
  .service-duration span { display: block; color: var(--color-muted); font-size: 0.77rem; font-weight: 400; margin-top: 0.2rem; }
  .service-bullets { list-style: none; padding: 0; margin: 1rem 0 1.5rem; display: flex; flex-direction: column; gap: 0.6rem; }
  .service-bullets li { position: relative; padding-left: 1rem; font-size: 0.85rem; color: var(--color-muted); line-height: 1.55; }
  .service-bullets li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 5px; height: 5px; border-radius: 50%; background: var(--color-maroon-500); }
  .service-link { align-self: flex-start; margin-top: auto; padding-block: 0.4rem; color: var(--color-maroon-700); font-weight: 600; font-size: 0.88rem; text-decoration: underline; text-decoration-color: var(--color-maroon-300); text-underline-offset: 4px; }
  .service-link:hover { text-decoration-color: currentColor; }
  .rates-note, .scope-note { max-width: 85ch; margin: 1.25rem auto 0; text-align: center; color: var(--color-muted); font-size: 0.8rem; line-height: 1.7; }
  .fit-call { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin-top: 2.5rem; padding: clamp(1.5rem, 3vw, 2.25rem); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-cream); }
  .fit-call h3 { margin: 0.3rem 0 0.55rem; }
  .fit-call p { max-width: 58ch; margin: 0; font-size: 0.92rem; color: var(--color-muted); }
  .fit-action { display: flex; flex-direction: column; align-items: center; gap: 0.65rem; flex-shrink: 0; }
  .fit-action > span { font-size: 0.8rem; color: var(--color-muted); }
  .fit-action .btn { font-size: 0.88rem; }
  .followup-section { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: 2.5rem; align-items: start; margin-top: 3rem; }
  .followup-heading h3 { margin: 0.4rem 0 0.65rem; }
  .followup-heading p { font-size: 0.9rem; color: var(--color-muted); max-width: 42ch; }
  .followup-list { margin: 0; }
  .followup-row { display: flex; justify-content: space-between; align-items: baseline; gap: 1.5rem; padding: 1rem 0; border-bottom: 1px solid var(--color-border); }
  .followup-row:first-child { padding-top: 0; }
  .followup-row dt { font-size: 0.9rem; font-weight: 600; }
  .followup-row dt span { display: block; color: var(--color-muted); font-size: 0.78rem; font-weight: 400; margin-top: 0.3rem; }
  .followup-row dd { flex-shrink: 0; margin: 0; color: var(--color-maroon-700); font-weight: 600; }
  .followup-row dd span { display: block; color: var(--color-muted); font-size: 0.75rem; font-weight: 400; }
  .scope-note { margin-top: 2rem; }
  .overnight-section { border-top: 1px solid var(--color-maroon-300); margin-top: 3rem; padding-top: 2.5rem; }
  .overnight-heading { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .overnight-heading h3 { margin: 0.35rem 0 0; font-size: 1.8rem; }
  .overnight-heading .service-link { margin-top: 0; align-self: center; }
  .overnight-options { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin: 1.5rem 0; }
  .overnight-options h4 { font-family: var(--font-body); font-size: 0.96rem; margin-bottom: 0.4rem; }
  .overnight-options p { color: var(--color-muted); font-size: 0.88rem; max-width: 55ch; }
  .overnight-details { border-top: 1px solid var(--color-border); }
  .overnight-details summary { display: flex; align-items: center; justify-content: space-between; padding: 1.15rem 0; color: var(--color-maroon-700); font-size: 0.95rem; font-weight: 600; cursor: pointer; list-style: none; }
  .overnight-details summary::-webkit-details-marker { display: none; }
  .overnight-details summary > span { font-size: 1.5rem; line-height: 1; transition: transform 0.2s; }
  .overnight-details[open] summary > span { transform: rotate(45deg); }
  .overnight-details summary:focus-visible { outline: 2px solid var(--color-maroon-700); outline-offset: 4px; }
  .packages-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin-top: 0.5rem; }
  .pkg-card { display: flex; flex-direction: column; align-items: center; padding: 1.5rem 0.9rem; border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-cream); text-align: center; }
  .pkg-name { font-family: var(--font-body); font-size: 0.7rem; color: var(--color-maroon-700); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.8rem; }
  .pkg-nights { font-family: var(--font-display); color: var(--color-maroon-900); font-size: 2.2rem; line-height: 1; margin: 0 0 0.4rem; }
  .pkg-nights span { font-family: var(--font-body); font-size: 0.85rem; color: var(--color-muted); }
  .pkg-timeframe { margin: 0 0 1rem; color: var(--color-muted); font-size: 0.8rem; }
  .pkg-price { font-family: var(--font-display); color: var(--color-maroon-700); font-size: 1.55rem; margin: 0 0 0.3rem; }
  .pkg-special { color: var(--color-muted); font-size: 0.73rem; margin: 0 0 1.2rem; }
  .pkg-cta { margin-top: auto; font-size: 0.8rem; color: var(--color-maroon-700); text-decoration: underline; text-underline-offset: 4px; padding-block: 0.4rem; }
  .packages-note { max-width: 72ch; color: var(--color-muted); font-size: 0.8rem; text-align: center; margin: 1.25rem auto 0; }
  @media (max-width: 1000px) {
    .services-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .service-card, .service-card.call-card { grid-column: span 1; }
    .service-card:last-child { grid-column: 1 / -1; }
    .followup-section { grid-template-columns: 1fr 1.3fr; gap: 1.5rem; }
    .packages-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 700px) {
    .services-grid { grid-template-columns: minmax(0, 1fr); }
    .service-card, .service-card.call-card, .service-card:last-child { grid-column: auto; }
    .fit-call { flex-direction: column; align-items: flex-start; gap: 1.25rem; }
    .fit-action { align-items: flex-start; }
    .followup-section, .overnight-options { grid-template-columns: 1fr; gap: 1rem; }
    .overnight-heading { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
    .overnight-heading .service-link { align-self: flex-start; }
  }
  @media (max-width: 400px) {
    .packages-grid { grid-template-columns: minmax(0, 1fr); }
    .followup-row { gap: 0.75rem; }
  }
</style>
