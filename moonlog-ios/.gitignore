# XcodeGen generates this from project.yml. Do not commit it — it is
# regenerated by every `xcodegen generate`, and committing it would put an
# unmergeable .pbxproj in the branch's diffs.
*.xcodeproj
*.xcworkspace

# Xcode build output
build/
DerivedData/
.build/

# Xcode user state
xcuserdata/
*.xcuserstate

# Swift Package Manager
Packages/
Package.resolved

# Misc
.DS_Store
